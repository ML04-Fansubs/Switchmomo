		{"text"},
		line=621,
	},
	{
		{"fg", id=1, path=":fg/001/", file="bz01101", face="tat_z0101201", x=0},
		{"mwf", path=":fa/001/", file="fac_0101201"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010601020"},
		{"text"},
		line=626,
	},
	{
		{"mwf"},
		{"vo", ch="sen11", path=":vo/011/", file="sen110601750"},
		{"text"},
		line=631,
	},
	{
		{"fg", id=1, path=":fg/001/", file="bz01201", face="tat_z0101202", x=0},
		{"mwf", path=":fa/001/", file="fac_0101202"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010601030"},
		{"text"},
		line=636,
	},
	{
		{"mwf"},
		{"vo", ch="sen11", path=":vo/011/", file="sen110601760"},
		{"text"},
		line=641,
	},
	{
		{"text"},
		line=643,
	},
	{
		{"text"},
