		{"mwf"},
		{"vo", ch="sen11", path=":vo/011/", file="sen110106020"},
		{"text"},
		line=520,
	},
	{
		{"fg", id=1, path=":fg/004/", file="bz04101", face="tat_z0401701", x=0},
		{"mwf", path=":fa/004/", file="fac_0401701"},
		{"vo", ch="sen04", path=":vo/004/", file="sen040102480"},
