	{
		{"fg", id=1, path=":fg/004/", file="bz04201", face="tat_z0401712", x=0},
		{"mwf", path=":fa/004/", file="fac_0401712"},
		{"vo", ch="sen04", path=":vo/004/", file="sen040102470"},
