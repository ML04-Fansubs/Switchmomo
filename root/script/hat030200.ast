	{
		{"fg", id=1, path=":fg/004/", file="bz04101", face="tat_z0401101", x=0},
		{"mwf", path=":fa/004/", file="fac_0401101"},
		{"vo", ch="sen04", path=":vo/004/", file="sen040302780"},
		{"text"},
		line=1201,
	},
	{
		{"fg", id=1, path=":fg/004/", file="bz04201", face="tat_z0401102", x=0},
		{"mwf", path=":fa/004/", file="fac_0401102"},
		{"vo", ch="sen04", path=":vo/004/", file="sen040302790"},
