		{"vo", ch="sen06", path=":vo/006/", file="sen067100230"},
		{"text"},
		line=1020,
	},
	{
		{"fg", id=2, path=":fg/005/", file="bz05204", face="tat_z0501502", x=300},
		{"mwf", path=":fa/005/", file="fac_0504502"},
		{"vo", ch="sen05", path=":vo/005/", file="sen057100430"},
		{"text"},
		line=1025,
	},
	{
		{"fg", id=1, path=":fg/006/", file="bz06202", face="tat_z0601232", x=-300},
		{"mwf", path=":fa/006/", file="fac_0602232"},
		{"vo", ch="sen06", path=":vo/006/", file="sen067100240"},
		{"text"},
		line=1030,
	},
	{
		{"fg", mode=-1, id=1, lv=""},
		{"fg", mode=-1, id=2, lv=""},
		{"mwf"},
