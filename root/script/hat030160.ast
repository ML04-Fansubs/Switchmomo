	{
		{"mwf"},
		{"se", id=1, file=07420, vol=88},
		{"ev", del=1, set="eve_0408", path=":ev/", file="eve_040804", time=900, rule="rand"},
		{"mwf", path=":fa/004/", file="fac_0401302"},
