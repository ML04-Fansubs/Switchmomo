	{
		{"ev", del=1, set="eve_0111", path=":ev/", file="eve_011102", time=3000},
		{"wa", time=3000},
		{"ev", del=1, set="eve_0111", path=":ev/", file="eve_011103", time=3000},
		{"wa", time=5000},
