		{"se", id=1, file=09254, vol=88},
		{"msgoff"},
		{"bg", del=1, path=":cg/06/", file="dc060100023", time=500},
		{"bg", film=1, lv=0, id=31, path=":bg/", file="white", mode="add", time=2000, sync=1},
