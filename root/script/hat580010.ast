		line=615,
	},
	{
		{"fg", id=1, path=":fg/002/", file="bzz02201", face="tat_zz0201882", x=0},
		{"mwf", path=":fa/002/", file="fac_0201882"},
		{"vo", ch="sen02", path=":vo/002/", file="sen025802350"},
