		},
		[195]={
			name={"name", name="Hotori"},
			{
"“It's fine. As long as I apologize nicely, it'll all be okay.”",
			},
		},
		[196]={
			name={"name", name="Hotori"},
			{
"“...Maybe I should quit being Natsumi?”",
			},
		},
