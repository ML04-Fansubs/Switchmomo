	{
		{"vo", ch="sen11", path=":vo/011/", file="sen110307560"},
		{"text"},
		line=1618,
	},
	{
		{"fg", id=2, path=":fg/002/", file="bz02203", face="tat_z0201402", x=300},
		{"vo", ch="sen11", path=":vo/011/", file="sen110307570"},
		{"text"},
		line=1624,
	},
	{
		{"fg", id=2, path=":fg/002/", file="bz02103", face="tat_z0201101", x=300},
		{"mwf", path=":fa/002/", file="fac_0203101"},
