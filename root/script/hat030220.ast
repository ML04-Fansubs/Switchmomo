		line=1605,
	},
	{
		{"fg", id=2, path=":fg/002/", file="bz02203", face="tat_z0201722", x=300},
		{"mwf", path=":fa/002/", file="fac_0203722"},
		{"vo", ch="sen02", path=":vo/002/", file="sen020307310"},
