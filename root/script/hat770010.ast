		line=680,
	},
	{
		{"mwf"},
		{"text"},
		line=685,
	},
	{
		{"fg", id=1, path=":fg/001/", file="bz01103", face="tat_z0101501", x=-300},
		{"mwf", path=":fa/001/", file="fac_0103501"},
