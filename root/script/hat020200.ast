	{
		{"se", id=1, file=02212, vol=88},
		{"fg", id=1, path=":fg/001/", file="bzz01101", face="tat_zz0101601", x=0},
		{"text"},
		line=642,
	},
	{
		{"fg", id=1, path=":fg/001/", file="bzz01301", face="tat_zz0101103", x=0},
		{"mwf", path=":fa/001/", file="fac_0101103"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010203580"},
