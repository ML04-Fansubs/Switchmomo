	},
	{
		{"fg", id=1, path=":fg/001/", file="bz01101", face="tat_z0101101", x=0},
		{"mwf", path=":fa/001/", file="fac_0101101"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010203590"},
