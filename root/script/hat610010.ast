		line=935,
	},
	{
		{"mwf", path=":fa/005/", file="fac_0502621"},
		{"vo", ch="sen05", path=":vo/005/", file="sen056100430"},
		{"text"},
		line=940,
	},
	{
		{"mwf"},
		{"text"},
		line=945,
	},
	{
		{"mwf", path=":fa/005/", file="fac_0502301"},
		{"vo", ch="sen05", path=":vo/005/", file="sen056100440"},
		{"text"},
		line=950,
	},
	{
		{"fg", id=1, path=":fg/001/", file="bz01102", face="tat_z0101701", x=0},
		{"mwf", path=":fa/001/", file="fac_0102701"},
		{"vo", ch="sen01", path=":vo/001/", file="sen016100100"},
		{"text"},
		line=955,
	},
	{
		{"mwf"},
		{"text"},
		line=960,
	},
	{
		{"eval", exp="g.no309=1"},
		{"exflgchk"},
		{"mwf"},
		{"msgoff"},
		{"bg", del=2, lv=0, id=31, path=":bg/", file="black", time=3000, wait=1500, sync=1},
		{"bgm", stop=1, [1]="", time=1500},
		{"sestop", id=1, time=1500},
		{"sestop", id=2, time=1500},
		{"sestop", id=3, time=1500},
		{"vo", id=1, stop=1},
		{"msgoff"},
		{"skipstop"},
		{"skipstop"},
		{"bg", del=1, path=":cg/07/", file="ed610010", time=3000},
		{"wa", time=5000},
		{"bg", del=1, path=":bg/", file="bg_0000", time=3000},
		{"skipstop"},
		{"exreturn"},
		line=960,
	},
	text={
		[1]={
			{
"With our field trip to the beach right around the corner─",
			},
		},
		[2]={
			{
"Those of us in the student council are hard at work making our final preparations.",
			},
		},
		[3]={
			name={"name", name="Kotone"},
			{
"“Hello, everyone! Please have some barley tea!”",
			},
		},
		[4]={
			name={"name", name="Akari"},
			{
"“Awesome, I was just starting to get thirs─”",
			},
		},
		[5]={
			name={"name", name="Kotone"},
			{
"“Ah... whoa, whoooa... Aaaaaaargghh!”",
			},
		},
		[6]={
			{
"A cup filled to the brim with barley tea soars through the air─",
			},
		},
		[7]={
			name={"name", name="Elsa"},
			{
"“Fwaaaah!”",
			},
		},
		[8]={
			{
"Landing a spectacular direct hit on Elsa.",
			},
		},
		[9]={
			name={"name", name="Kotone"},
			{
"“Awawawawa, I'm so sorry! I'm so sorry! I'm so sorry! I'll go fetch a cloth right away!”",
			},
		},
		[10]={
			name={"name", name="Elsa"},
			{
"“Don't bother. I'll wipe it myself.”",
			},
		},
		[11]={
			{
"Elsa resignedly takes out her handkerchief.",
			},
		},
		[12]={
			name={"name", name="Elsa"},
			{
"“Why are you always tripping over yourself?”",
			},
		},
		[13]={
			name={"name", name="Elsa"},
			{
"“I swear, is it your life's mission to get me wet?”",
			},
		},
		[14]={
			name={"name", name="Kotone"},
			{
"“Perish the thought! I assure you that it was not on purpose!”",
			},
		},
		[15]={
			name={"name", name="Kotone"},
			{
"“It is just that, um, my nerves may have caused my feet to become unsteady, and─”",
			},
		},
		[16]={
			name={"name", name="Elsa"},
			{
"“Urgh, I know I put you on the student council on a whim, but I'm starting to have some concerns.”",
			},
		},
		[17]={
			name={"name", name="Kotone"},
			{
"“On a whim?”",
			},
		},
		[18]={
			name={"name", name="Elsa"},
			{
"“Ah, ahem.”",
			},
		},
		[19]={
			name={"name", name="Elsa"},
			{
"“I know I put you on the student council because you're the Exalt-Priestess, but I'm starting to have some concerns.”",
			},
		},
		[20]={
			name={"name", name="Kanami"},
			{
"“Oh, what an impressive retraction.”",
			},
		},
		[21]={
			name={"name", name="Hotori"},
			{
"“A real politician, aren't you?”",
			},
		},
		[22]={
			name={"name", name="Elsa"},
			{
"“Quiet, you.”",
			},
		},
		[23]={
			{
"Elsa neatly folds the handkerchief she'd wiped her hair with.",
			},
		},
		[24]={
			name={"name", name="Elsa"},
			{
"“Shiinoha-san, perhaps you need some extra training.”",
			},
		},
		[25]={
			name={"name", name="Kotone"},
			{
"“For making tea?”",
			},
		},
		[26]={
			name={"name", name="Elsa"},
			{
"“For being a proper student council member.”",
			},
		},
		[27]={
			name={"name", name="Elsa"},
			{
"“Since when did your job become fetching tea anyway?”",
			},
		},
		[28]={
			name={"name", name="Kotone"},
			{
"“But I am afraid that is all I am good for...”",
			},
		},
		[29]={
			name={"name", name="Elsa"},
			{
"“You're not resting until you find yourself some new redeeming quality. Understand?”",
			},
		},
		[30]={
			name={"name", name="Kotone"},
			{
"“S-Sir, yes, sir!”",
			},
		},
		[31]={
			{
"Kotone snaps off a crisp, Republican-style salute.",
			},
		},
		[32]={
			{
"Let's just put aside the fact that for female superiors, the proper form of address is “ma'am.”",
			},
		},
		[33]={
			name={"name", name="Hotori"},
			{
"“Haah...”",
			},
		},
		[34]={
			name={"name", name="Akari"},
			{
"“Whew...”",
			},
		},
		[35]={
			name={"name", name="Elsa"},
			{
"“Can't you do ",
{"font", face="font/02.ttf", size=55, kerning=-3.5, hung=1},
"anything",
{"/font"},
" right?”",
			},
		},
		[36]={
			name={"name", name="Kotone"},
			{
"“You needn't be so blunt about it...”",
			},
		},
		[37]={
			{
"Kotone slumps forward, her forehead pressed against the floor.",
			},
		},
		[38]={
			{
"She's attempted everything from accounting to scribing to cleaning, all to truly unfortunate results.",
			},
		},
		[39]={
			name={"name", name="Soujin"},
			{
"“You have very nice handwriting, Kotone. You could make for a good secretary.”",
			},
		},
		[40]={
			name={"name", name="Elsa"},
			{
"“With a pen, sure.”",
			},
		},
		[41]={
			name={"name", name="Elsa"},
			{
"“But nobody writes records by hand nowadays.”",
			},
		},
		[42]={
			name={"name", name="Kotone"},
			{
"“Say ",
{"font", face="font/02.ttf", size=55, kerning=-3.5, hung=1},
"no",
{"/font"},
" to handwritten ",
{"font", face="font/02.ttf", size=55, kerning=-3.5, hung=1},
"no",
{"/font"},
"-tes!”",
			},
		},
		[43]={
			name={"name", name="Elsa"},
			{
"“Shiinoha-san?”",
			},
		},
		[44]={
			name={"name", name="Kotone"},
			{
"“I'm sorry, I'm sorry! I'm sorry for ever being born!”",
			},
		},
		[45]={
			name={"name", name="Elsa"},
			{
"“Ahhaaaah...”",
			},
		},
		[46]={
			{
"Elsa directs a warm gaze down at Kotone's prostrate form.",
			},
		},
		[47]={
			{
"She doesn't seem genuinely upset, at least.",
			},
		},
		[48]={
			name={"name", name="Kanami"},
			{
"“Um, perhaps we ought to take a break?”",
			},
		},
		[49]={
			name={"name", name="Kanami"},
			{
"“The manjuu I ordered from Samuraya just arrived, after all.”",
			},
		},
		[50]={
			name={"name", name="Kotone"},
			{
"“Samuraya?!”",
			},
		},
		[51]={
			{
"Kotone's face lights up immediately.",
			},
		},
		[52]={
			name={"name", name="Elsa"},
			{
"“I doubt we'll make much more progress anyway. Let's call it a day here.”",
			},
		},
		[53]={
			name={"name", name="Kotone"},
			{
"“Thank you very much!”",
			},
		},
		[54]={
			{
"Kotone immediately proceeds to dig in to the manjuu Kanami hands her.",
			},
		},
		[55]={
			name={"name", name="Elsa"},
			{
"“Hehee, you look so happy while you eat that it's hard to stay mad at you.”",
			},
		},
		[56]={
			name={"name", name="Kotone"},
			{
"“Yes, I have heard that many times before! Omnomnom...”",
			},
		},
		[57]={
			{
"For the price of only a single manjuu, Kotone's managed to lighten up the entire room.",
			},
		},
		[58]={
			{
"When you think about it, there are few qualities more redeeming than that.",
			},
		},
		[59]={
			name={"name", name="Akari"},
			{
"“Hmm? There's still a manjuu left over.”",
			},
		},
		[60]={
			name={"name", name="Kanami"},
			{
"“That one is for Kurushima-san.”",
			},
		},
		[61]={
			name={"name", name="Elsa"},
			{
"“Oh, Shino? She's not coming today.”",
			},
		},
		[62]={
			name={"name", name="Kotone"},
			{
"“O-ho? What a teeerrible shame.”",
			},
		},
		[63]={
			name={"name", name="Kotone"},
			{
"“Truly, what a shame! Such a shame indeed!”",
			},
		},
		[64]={
			{
"Though she's trying her best to hide her eagerness, the wide smile spreading across her face says otherwise.",
			},
		},
		[65]={
			name={"name", name="Soujin"},
			{
"“It's all yours, Kotone.”",
			},
		},
		[66]={
			name={"name", name="Kotone"},
			{
"“May I truly partake of such a blessing?!”",
			},
		},
		[67]={
			{
"Kotone leaps instantly to her feet.",
			},
		},
		[68]={
			{
"Everyone's eyes go wide at her uncanny display of agility.",
			},
		},
		[69]={
			name={"name", name="Kotone"},
			{
"“Ah... Ahem.”",
			},
		},
		[70]={
			name={"name", name="Kotone"},
			{
"“Oh, but I fear this makes it seem as though I covet it for myself...”",
			},
		},
		[71]={
			name={"name", name="Hotori"},
			{
"“Who're you trying to fool?”",
			},
		},
		[72]={
			name={"name", name="Elsa"},
			{
"“We really don't mind, so go right ahead.”",
			},
		},
		[73]={
			name={"name", name="Kotone"},
			{
"“As the Exalt-Priestess, such avidity does not become my station.”",
			},
		},
		[74]={
			name={"name", name="Kotone"},
			{
"“I must insist that we decide fairly through rock-paper-scissors!”",
			},
		},
		[75]={
			{
"Kotone declares, thrusting aloft her clenched fist.",
			},
		},
		[76]={
			{
"The rest of us are happy to play along.",
			},
		},
		[77]={
			name={"name", name="Kotone"},
			{
"“Now then, let our battle commence!”",
			},
		},
		[78]={
			name={"name", name="Kotone"},
			{
"“Rock! Paper! Scissors!”",
			},
		},
		[79]={
			{
"Round one─",
			},
		},
		[80]={
			name={"name", name="Kanami"},
			{
"“Ooh...”",
			},
		},
		[81]={
			{
"Kanami is eliminated.",
			},
		},
		[82]={
			{
"Round two─",
			},
		},
		[83]={
			name={"name", name="Elsa"},
			{
"“Oh, how unfortunate.”",
			},
		},
		[84]={
			name={"name", name="Hotori"},
			{
"“Curses. Should've thrown rock...”",
			},
		},
		[85]={
			{
"Both Elsa and Hotori are eliminated.",
			},
		},
		[86]={
			{
"Round three─",
			},
		},
		[87]={
			name={"name", name="Kotone"},
			{
"“Aaaaaaaaahhhhh!”",
			},
		},
		[88]={
			name={"name", name="Kotone"},
			{
"“Victory is mine, is it not?! Victory is mine!”",
			},
		},
		[89]={
			name={"name", name="Akari"},
			{
"“Obsession wins the day, it'd seem.”",
			},
		},
		[90]={
			name={"name", name="Soujin"},
			{
"“Gotta admit hunger is a powerful weapon. Anyway, to the victor go the spoils.”",
			},
		},
		[91]={
			{
"I hand Kotone the leftover manjuu.",
			},
		},
		[92]={
			name={"name", name="Kotone"},
			{
"“Thank you kindly. Now, don't mind if I do!”",
			},
		},
		[93]={
			{
"Kotone offers a heartfelt prayer to Oomikami before proceeding to devour her prize.",
			},
		},
		[94]={
			{
"The expression of pure bliss on her face is a sight to behold.",
			},
		},
		[95]={
			name={"name", name="Elsa"},
			{
"“I'm glad it went to the person who wanted it the most.\nDon't you think the manjuu's happier this way, too?”",
			},
		},
		[96]={
			name={"name", name="Kotone"},
			{
"“Truth be told, I am rather confident in my rock-paper-scissors skills! I cannot remember having lost even once.”",
			},
		},
		[97]={
			name={"name", name="Elsa"},
			{
"“Seriously? ",
{"font", face="font/02.ttf", size=55, kerning=-3.5, hung=1},
"Never?",
{"/font"},
" That's impossible.”",
			},
		},
		[98]={
			name={"name", name="Kotone"},
			{
"“It is the truth.”",
			},
		},
		[99]={
			name={"name", name="Kotone"},
			{
"“Everyone back in Iseya used to tease me by saying that I must have been selected as Exalt-Priestess through rock-paper-scissors!”",
			},
		},
		[100]={
			{
"Kotone pridefully puffs out her chest.",
			},
		},
		[101]={
			name={"name", name="Hotori"},
			{
"“Very well. Let's see how strong you really are.”",
			},
		},
		[102]={
			name={"name", name="Kotone"},
			{
"“I gladly accept your challenge!”",
			},
		},
		[103]={
			{
"The two combatants stand and face each other.",
			},
		},
		[104]={
			name={"name", name="Hotori"},
			{
"“Inou Hotori, of the Myougikan.”",
			},
		},
		[105]={
			name={"name", name="Kotone"},
			{
"“Shiinoha Kotone, the 192th Exalt-Priestess, stands before you.”",
			},
		},
		[106]={
			{
"The air in the student council office grows thick with tension.",
			},
		},
		[107]={
			name={"name", name="Hotori & Kotone"},
			{
"“Rock, paper, scissors, shoot!” “Rock, paper, scissors, shoot!”",
			},
		},
		[108]={
			{
"─On this day, those of us present in the student council office bore witness to a miracle.",
			},
		},
		[109]={
			{
"Ten consecutive wins.",
			},
		},
		[110]={
			{
"Kotone easily dispatched Hotori ten times in a row without so much as breaking a sweat.",
			},
		},
		[111]={
			name={"name", name="Hotori"},
			{
"“I-Impossible...!”",
			},
		},
		[112]={
			name={"name", name="Kotone"},
			{
"“There is no shame in defeat.”",
			},
		},
		[113]={
			name={"name", name="Kotone"},
			{
"“As Oomikami wills, so it shall be. Resist not the inevitable.”",
			},
		},
		[114]={
			{
"Kotone murmurs sagely with half-lidded eyes.",
			},
		},
		[115]={
			{
"Before our very eyes, she has ascended to a higher plane of existence.",
			},
		},
		[116]={
			name={"name", name="Elsa"},
			{
"“That's impossible! There has to be some trick!”",
			},
		},
		[117]={
			name={"name", name="Kotone"},
			{
"“Sully not your soul with such shameful doubts.”",
			},
		},
		[118]={
			name={"name", name="Kotone"},
			{
"“Now, come forth if you dare, foreign general.”",
			},
		},
		[119]={
			name={"name", name="Elsa"},
			{
"“Ghh!”",
			},
		},
		[120]={
			name={"name", name="Elsa"},
			{
"“Rock! Paper! Scissors─!”",
			},
		},
		[121]={
			name={"name", name="Elsa"},
			{
"“Ten losses... in a row?”",
			},
		},
		[122]={
			{
"Elsa's legs crumple beneath her.",
			},
		},
		[123]={
			name={"name", name="Kotone"},
			{
"“Empty your mind first, you must.”",
			},
		},
		[124]={
			name={"name", name="Kotone"},
			{
"“Render your heart as unto a polished mirror, and victory shall be not in doubt, even in a hundred battles.”",
			},
		},
		[125]={
			{
"If we count her match against Hotori as well, Kotone is up to twenty consecutive wins.",
			},
		},
		[126]={
			name={"name", name="Akari"},
			{
"“Th-This has got to be some sorta miracle, right?”",
			},
		},
		[127]={
			name={"name", name="Kanami"},
			{
"“I-Indeed.”",
			},
		},
		[128]={
			name={"name", name="Soujin"},
			{
"“See, Kotone, you have a talent no one else does.”",
			},
		},
		[129]={
			name={"name", name="Soujin"},
			{
"“As long as you use it properly, it can be a powerful weapon.”",
			},
		},
		[130]={
			name={"name", name="Kotone"},
			{
"“Ah! I never thought about it that way before.”",
			},
		},
		[131]={
			name={"name", name="Kotone"},
			{
"“But I believe you are correct! It seems I have finally found a way to make myself useful!”",
			},
		},
		[132]={
			name={"name", name="Kotone"},
			{
"“Thank you so much, Soujin-sama! You have my eternal gratitude!”",
			},
		},
		[133]={
			{
"Kotone grabs my hand with both of her own and furiously shakes it up and down.",
			},
		},
		[134]={
			name={"name", name="Elsa"},
			{
"“Don't you celebrate just yet!”",
			},
		},
		[135]={
			name={"name", name="Elsa"},
			{
"“Face me one more time.”",
			},
		},
		[136]={
			{
"Kotone allows my hand to slip gently from her grasp.",
			},
		},
		[137]={
			{
"Meanwhile, her countenance takes on the sagely mien of a rock-paper-scissors master.",
			},
		},
		[138]={
			name={"name", name="Kotone"},
			{
"“You have chosen... unwisely.”",
			},
		},
		[139]={
			name={"name", name="Kotone"},
			{
"“Struggle on in futility, for the outcome shall ever remain the same.”",
			},
		},
		[140]={
			{
"Kotone unhurriedly turns to face off against Elsa.",
			},
		},
		[141]={
			name={"name", name="Elsa"},
			{
"“Shiinoha-san?”",
			},
		},
		[142]={
			name={"name", name="Elsa"},
			{
"“This round, I'm going to play paper.”",
			},
		},
		[143]={
			name={"name", name="Kotone"},
			{
"“Fweh?!”",
			},
		},
		[144]={
			name={"name", name="Elsa"},
			{
"“If you believe me, just play scissors.”",
			},
		},
		[145]={
			name={"name", name="Elsa"},
			{
"“But if you think I'm lying, go ahead and play paper or rock.”",
			},
		},
		[146]={
			name={"name", name="Kotone"},
			{
"“Hweh? Ahh...”",
			},
		},
		[147]={
			name={"name", name="Elsa"},
			{
"“Well, Shiinoha-san? Do you trust me or not?”",
			},
		},
		[148]={
			name={"name", name="Akari"},
			{
"“That's beyond cunning─it's downright dirty.”",
			},
		},
		[149]={
			name={"name", name="Soujin"},
			{
"“No kidding.”",
			},
		},
		[150]={
			name={"name", name="Elsa"},
			{
"“Now, here we go!”",
			},
		},
		[151]={
			name={"name", name="Kotone"},
			{
"“Awawawawawa?!”",
			},
		},
		[152]={
			name={"name", name="Elsa"},
			{
"“Rock, paper, scissors, shoot!”",
			},
		},
		[153]={
			{
"Elsa throws out rock─",
			},
		},
		[154]={
			{
"Meanwhile, Kotone throws...",
			},
