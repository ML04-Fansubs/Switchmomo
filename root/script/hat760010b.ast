	{
		{"fg", id=1, path=":fg/006/", file="bzz06202", face="tat_zz0601852", x=0},
		{"mwf", path=":fa/006/", file="fac_0602852"},
		{"vo", ch="sen06", path=":vo/006/", file="sen067604110"},
