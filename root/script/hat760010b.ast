		line=1533,
	},
	{
		{"vo", ch="sen11", path=":vo/011/", file="sen117601480"},
		{"text"},
		line=1536,
	},
	{
		{"fg", id=1, path=":fg/006/", file="bzz06102", face="tat_zz0601921", x=0},
		{"mwf", path=":fa/006/", file="fac_0602921"},
