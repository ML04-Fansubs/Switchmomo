	{
		{"fg", id=1, path=":fg/001/", file="bz01103", face="tat_z0101501", x=0},
		{"mwf", path=":fa/001/", file="fac_0103501"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010201310"},
