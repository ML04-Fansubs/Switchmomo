	{
		{"fg", id=1, path=":fg/001/", file="bz01103", face="tat_z0101201", x=0},
		{"mwf", path=":fa/001/", file="fac_0103201"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010201320"},
