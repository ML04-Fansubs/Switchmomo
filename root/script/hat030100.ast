	},
	{
		{"fg", id=1, path=":fg/012/", file="bz12101", face="tat_z1201201", x=0},
		{"mwf", path=":fa/012/", file="fac_1201201"},
		{"vo", ch="sen12", path=":vo/012/", file="sen120300430"},
