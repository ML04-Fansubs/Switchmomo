		line=559,
	},
	{
		{"fg", id=1, path=":fg/003/", file="bz03201", face="tat_z0301462", x=-300},
		{"mwf", path=":fa/003/", file="fac_0301462"},
		{"vo", ch="sen03", path=":vo/003/", file="sen030505770"},
		{"text"},
		line=564,
	},
	{
		{"fg", id=2, path=":fg/023/", file="bz23101", face="tat_z2301101", x=300},
		{"mwf", path=":fa/023/", file="fac_2301101"},
		{"vo", ch="sen23", path=":vo/023/", file="sen230501830"},
		{"text"},
		line=569,
	},
	{
		{"fg", id=1, path=":fg/003/", file="bz03201", face="tat_z0301202", x=-300},
		{"mwf", path=":fa/003/", file="fac_0301202"},
		{"vo", ch="sen03", path=":vo/003/", file="sen030505780"},
		{"text"},
		line=574,
	},
	{
		{"fg", id=2, path=":fg/023/", file="bz23101", face="tat_z2301201", x=300},
		{"mwf", path=":fa/023/", file="fac_2301201"},
		{"vo", ch="sen23", path=":vo/023/", file="sen230501840"},
		{"text"},
		line=579,
	},
	{
		{"fg", id=1, path=":fg/003/", file="bz03201", face="tat_z0301212", x=-300},
		{"mwf", path=":fa/003/", file="fac_0301212"},
		{"vo", ch="sen03", path=":vo/003/", file="sen030505790"},
