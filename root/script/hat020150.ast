	{
		{"fg", id=1, path=":fg/017/", file="bz17105", face="tat_z1701501", x=0},
		{"mwf", path=":fa/017/", file="fac_1705501"},
		{"vo", ch="sen17", path=":vo/017/", file="sen170202030"},
