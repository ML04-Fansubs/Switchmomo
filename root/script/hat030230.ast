		line=636,
	},
	{
		{"mwf"},
		{"msgoff"},
		{"bg", del=2, lv=0, id=31, path=":bg/", file="black", time=1000, wait=500, sync=1},
		{"bgm", stop=1, [1]="", time=1500},
		{"bg", del=1, path=":bg/", file="bg_5031", time=900, rule="rand"},
		{"bgm", path=":bg/", file="bgm_2020", vol=88},
