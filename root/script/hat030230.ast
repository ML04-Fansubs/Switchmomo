	},
	{
		{"fg", id=1, path=":fg/002/", file="bzz02203", face="tat_zz0201872", x=0},
		{"mwf", path=":fa/002/", file="fac_0203872"},
		{"vo", ch="sen02", path=":vo/002/", file="sen029203180r"},
		{"text"},
		line=620,
	},
	{
		{"fg", id=1, path=":fg/002/", file="bzz02203", face="tat_zz0201882", x=0},
		{"mwf", path=":fa/002/", file="fac_0203882"},
		{"vo", ch="sen02", path=":vo/002/", file="sen029203200"},
