		line=1945,
	},
	{
		{"fg", id=1, path=":fg/005/", file="bz05202", face="tat_z0501112", x=0},
		{"mwf", path=":fa/005/", file="fac_0502112"},
		{"vo", ch="sen05", path=":vo/005/", file="sen050302060"},
		{"text"},
		line=1950,
