	{
		{"fg", id=1, path=":fg/020/", file="bz20301", face="tat_z2001123", x=0, days=2},
		{"mwf", path=":fa/020/", file="fac_2001123"},
		{"vo", ch="sen20", path=":vo/020/", file="sen200403310"},
