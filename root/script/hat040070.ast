		line=1131,
	},
	{
		{"mwf"},
		{"vo", ch="sen11", path=":vo/011/", file="sen110402490"},
		{"text"},
		line=1137,
	},
	{
		{"fg", id=1, path=":fg/020/", file="bz20301", face="tat_z2001113", x=0, days=2},
		{"mwf", path=":fa/020/", file="fac_2001113"},
		{"vo", ch="sen20", path=":vo/020/", file="sen200403320"},
		{"text"},
		line=1142,
	},
	{
		{"fg", id=1, path=":fg/020/", file="bz20301", face="tat_z2001103", x=0, days=2},
		{"mwf", path=":fa/020/", file="fac_2001103"},
		{"vo", ch="sen20", path=":vo/020/", file="sen200403330"},
