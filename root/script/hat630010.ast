	},
	{
		{"fg", id=1, path=":fg/003/", file="bzz03101", face="tat_zz0301861", x=0},
		{"mwf", path=":fa/003/", file="fac_0301861"},
		{"vo", ch="sen03", path=":vo/003/", file="sen036303020"},
