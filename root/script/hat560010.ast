		[84]={
			name={"name", name="Kanami"},
			{
"“Sorry, but we're quite busy at the moment!”",
			},
		},
		[85]={
			name={"name", name="Takahito"},
			{
"“Oh, no, you really ought to hear this for your own good.”",
			},
		},
		[86]={
			name={"name", name="Takahito"},
			{
"“Why, you two have absolutely no idea about how Soujin-kun feels.”",
			},
		},
		[87]={
