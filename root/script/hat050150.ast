	{
		{"bgm", stop=1, [1]="", time=1500},
		{"mwf"},
		{"msgoff"},
		{"bg", del=2, lv=0, id=31, path=":bg/", file="white", time=1000, wait=500, sync=1},
		{"viewend", mode="off"},
