		{"fg", id=1, path=":fg/001/", file="bz01202", face="tat_z0101702", x=0},
		{"mwf", path=":fa/001/", file="fac_0102702"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010108580"},
