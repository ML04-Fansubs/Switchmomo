		},
		[91]={
			name={"name", name="Soujin"},
			{
"“It's only natural that a lord and her vassal should remain together.”",
			},
		},
		[92]={
			name={"name", name="Akari"},
			{
"“You don't have to feel obligated to me forever.”",
