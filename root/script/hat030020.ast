		line=530,
	},
	{
		{"fg", id=1, path=":fg/001/", file="bz01202", face="tat_z0101202", x=0},
		{"mwf", path=":fa/001/", file="fac_0102202"},
		{"vo", ch="sen01", path=":vo/001/", file="sen010300340"},
